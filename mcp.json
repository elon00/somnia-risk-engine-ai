{
  "mcpServers": {
    "somnia-risk-engine-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Somnia Network",
        "PROJECT_TICKER": "SOMRISK"
      },
      "tools": [
        {
          "name": "verify_somrisk_invariants",
          "description": "Verifies deterministic invariants for Somnia Risk Engine AI on Somnia Network."
        },
        {
          "name": "execute_somrisk_action",
          "description": "Executes authenticated Risk state transition."
        }
      ]
    }
  }
}